# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Server-side only (never expose with VITE_ prefix).
TMDB_API_KEY="MY_TMDB_API_KEY"

# Supabase Configuration (New Publishable & Secret API Keys)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLISHABLE_KEY"
# Server-side only (never expose with VITE_ prefix):
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_YOUR_SECRET_KEY"

# Optional external backend URL when hosting static frontend on GitHub Pages
VITE_API_BASE_URL=""
VITE_BASE_PATH="/"
